# Backend API base URL
VITE_API_BASE_URL=http://localhost:5037

# Credentials used for the automatic login on startup.
# Must match Auth:Username / Auth:Password in the backend configuration.
VITE_AUTH_USERNAME=admin
VITE_AUTH_PASSWORD=your-login-password

# Schema name shown in the navbar breadcrumb
VITE_MAIN_SCHEMA=SBODEMO
