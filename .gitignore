## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
backend/wwwroot/assets/
backend/wwwroot/index.html
backend/wwwroot/test_json/
bin/
obj/
[Ll]og/
*.log

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Visual Studio working folders
.vscode/
.vs/
.vscode-test/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET publish folder
wwwroot/dist/
wwwroot/node_modules/
wwwroot/lib/

# Npm packages
node_modules/
package-lock.json
yarn.lock

# Environment files
.env
.env.*

# Others
#*.db
*.sqlite
*.bak
*.cache
*.pid
*.psess
*.vsp
*.pdb
*.mdb

# JetBrains Rider
.idea/
*.sln.iml

# Mac / Linux
.DS_Store
Thumbs.db

# Rider & Resharper
*.DotSettings.user
_ReSharper*/

# Local configuration with real credentials (see *.example files)
backend/appsettings.Development.json
backend/appsettings.Production.json
backend/appsettings.Local.json
frontend/.env
frontend/.env.local

# Local databases
backend/*.db
backend/*.db-*
crawler/*.db
crawler/*.db-*

# Keep example/env templates and the frontend lockfile
!.env.example
!frontend/package-lock.json
